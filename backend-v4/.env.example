KEEPER_DB_DSN="mysql:host=127.0.0.1;port=3306;dbname=keeper_v4;charset=utf8mb4"
KEEPER_DB_USER=keeper_app
KEEPER_DB_PASSWORD=
# Alternatively read the password from a protected file.
KEEPER_DB_PASSWORD_FILE=
KEEPER_ORIGIN=http://127.0.0.1:8080
KEEPER_ALLOW_HTTP_LOCAL=1
# Comma-separated proxy addresses; proxy must overwrite X-Forwarded-Proto and preserve Host.
KEEPER_TRUSTED_PROXY_IPS=
# Required: base64 of 32 random bytes, stored outside the database.
KEEPER_RESPONSE_KEY=
KEEPER_RESPONSE_KEY_ID=local-1
KEEPER_RATE_DIR=
KEEPER_DEBUG=0
KEEPER_DEVICE_RATE=2
KEEPER_DEVICE_BURST=5
KEEPER_TENANT_FLEET=1000
KEEPER_BOOTSTRAP_RATE=5
KEEPER_BOOTSTRAP_BURST=5
KEEPER_CHALLENGE_OUTSTANDING=20
