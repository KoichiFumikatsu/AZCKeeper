<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Version>4.0.0</Version>
  </PropertyGroup>
  <!-- Mismo conjunto de runtime que Agent/Session (ver Keeper.Agent.csproj). -->
  <ItemGroup><FrameworkReference Include="Microsoft.WindowsDesktop.App" /></ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Keeper.Bootstrapper.Tests" />
    <!-- Rescate independiente: viaja en el paquete (agent\recovery\) y el bootstrapper lo instala una sola vez. -->
    <None Include="recovery\Keeper-Recovery.ps1" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Using Remove="Keeper.Shared.Policy" />
    <ProjectReference Include="../Keeper.Shared/Keeper.Shared.csproj" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="8.0.1" />
  </ItemGroup>
</Project>
